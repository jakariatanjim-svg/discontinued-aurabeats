                    window.caches.keys().then((keys) => {
                      Promise.all(keys.map((k) => window.caches.delete(k))).then(() => {
                        if (navigator.serviceWorker) {
                          navigator.serviceWorker.getRegistrations().then((regs) => {
                            regs.forEach(reg => reg.unregister());
