{
  "name": "aurabeats",
  "version": "1.0.0",
  "main": "main.js",
  "author": "jakariatanjim-svg",
  "license": "MIT",
  "repository": "github:jakariatanjim-svg/aurabeats",
  "build": {
    "appId": "dev.pages.aurabeats",
    "productName": "AuraBeats",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app-bundle/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "app-bundle/icon-512.png"
    },
    "portable": {
      "artifactName": "AuraBeats-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
