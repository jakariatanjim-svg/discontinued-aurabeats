                  >
                    <span className="w-5 shrink-0 text-center text-[11px] tabular-nums text-white/40">{i + 1}</span>
                    <Artwork
                      src={t.artwork || undefined}
                      fallbackSrc={t.artworkFallback}
                      alt={t.title}
                      className="h-9 w-9 shrink-0"
